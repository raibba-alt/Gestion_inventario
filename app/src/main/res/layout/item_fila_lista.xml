<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:padding="8dp"
    android:layout_marginBottom="4dp"
    android:background="#FAFAFA">

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical"
        android:layout_marginEnd="8dp">
        <TextView
            android:id="@+id/tvFilaTitulo"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="#2C3E50"
            android:textSize="15sp"
            android:textStyle="bold" />
        <TextView
            android:id="@+id/tvFilaSubtitulo"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="#7F8C8D"
            android:textSize="13sp"
            android:layout_marginTop="2dp" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:gravity="center">
        <Button android:id="@+id/btnEditarFila" android:layout_width="40dp" android:layout_height="35dp" android:text="✏️" android:textSize="14sp" android:padding="0dp" android:backgroundTint="#3498DB" android:textColor="#FFFFFF"/>
        <Button android:id="@+id/btnBorrarFila" android:layout_width="40dp" android:layout_height="35dp" android:text="🗑️" android:textSize="14sp" android:padding="0dp" android:layout_marginTop="4dp" android:backgroundTint="#E74C3C" android:textColor="#FFFFFF"/>
    </LinearLayout>

</LinearLayout>