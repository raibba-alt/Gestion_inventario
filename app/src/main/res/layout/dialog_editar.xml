<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="20dp">

    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Código:" android:textSize="16sp" android:layout_marginTop="8dp"/>
    <EditText android:id="@+id/etDialogCod" android:layout_width="match_parent" android:layout_height="50dp" android:inputType="text" android:background="@android:color/white" android:padding="8dp"/>

    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="EAN13:" android:textSize="16sp" android:layout_marginTop="12dp"/>
    <EditText android:id="@+id/etDialogEan" android:layout_width="match_parent" android:layout_height="50dp" android:inputType="number" android:background="@android:color/white" android:padding="8dp"/>

    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Unidades:" android:textSize="16sp" android:layout_marginTop="12dp"/>
    <EditText android:id="@+id/dialogUds" android:layout_width="match_parent" android:layout_height="50dp" android:inputType="number" android:background="@android:color/white" android:padding="8dp"/>

    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Descripción:" android:textSize="16sp" android:layout_marginTop="12dp"/>
    <EditText android:id="@+id/etDialogDesc" android:layout_width="match_parent" android:layout_height="50dp" android:inputType="text" android:background="@android:color/white" android:padding="8dp"/>

</LinearLayout>